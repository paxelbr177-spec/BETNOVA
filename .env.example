# Supabase (opcional). Copia este archivo a ".env" y rellena tus claves
# para activar el login REAL con usuarios persistentes.
#
# Sin estas variables, BetNova usa un "modo local" (localStorage): el registro
# y el login funcionan en el navegador para el demo, pero no persisten en la nube.
#
# Las encuentras en tu proyecto de Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
